# Copy to .env and adjust. Used by docker-compose and local dev.

# --- Postgres / TimescaleDB ---
POSTGRES_USER=webmana
POSTGRES_PASSWORD=webmana
POSTGRES_DB=webmana
POSTGRES_PORT=5432

# Connection string used by the apps. Host is "postgres" inside Docker.
DATABASE_URL=postgres://webmana:webmana@postgres:5432/webmana

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- API ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# --- MCP ---
MCP_PORT=4100
# Dev-only bearer token for the MCP HTTP/SSE transport (Phase 0 stub).
# Replace with real mcp_tokens lookup in Phase 3.
MCP_DEV_TOKEN=change-me

# --- Security ---
# Key used to encrypt connector secrets at rest (set a long random value).
WEBMANA_SECRETS_KEY=change-me-to-a-long-random-string
