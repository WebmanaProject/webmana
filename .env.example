# Webmana environment configuration.
# Copy to `.env` and adjust. Never commit your real `.env`.
#
#   cp .env.example .env
#
# Every value below has a safe default in docker-compose.yml, but you MUST
# change the secrets (passwords, SECRET_ENCRYPTION_KEY, MCP_TOKEN) before
# exposing Webmana to anything but localhost.

# ---- Database (Postgres / TimescaleDB) ----
POSTGRES_USER=webmana
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=webmana
# Host port mapped to the postgres container (container port is always 5432).
POSTGRES_PORT=5432
# Full URL used by api/worker/mcp. Host is the compose service name "postgres".
DATABASE_URL=postgres://webmana:change-me-strong@postgres:5432/webmana

# ---- Redis (BullMQ queue) ----
# Host port mapped to the redis container (container port is always 6379).
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ---- Auth ----
# Secret used to sign session JWTs (HS256). Generate: openssl rand -base64 48
JWT_SECRET=change-me-long-random
# Set "true" in production (HTTPS) so the session cookie is Secure-only.
COOKIE_SECURE=false
# Initial admin, seeded on first boot only if no users exist yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-admin-password

# ---- API (NestJS) ----
API_PORT=4000
# Public base URL the browser uses to reach the API (used by the web app
# client-side). Set to your reverse-proxy URL in production.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Internal base URL the web server uses to reach the API (server-side fetch,
# inside the compose network). Usually the compose service name.
API_URL=http://api:4000

# ---- Web (Next.js dashboard) ----
WEB_PORT=3000
# AGPL §13: link shown in the app footer to the running source. If you modify
# Webmana and run it for others, point this at your fork.
SOURCE_URL=https://github.com/WebmanaProject/webmana

# ---- Crypto ----
# 32-byte key used to encrypt connector secrets at rest (AES-256-GCM).
# Generate: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=change-me-32-bytes-base64

# ---- MCP server ----
MCP_PORT=4100
# Bearer token clients must present to the remote (HTTP/SSE) MCP server.
MCP_TOKEN=change-me-mcp-token

# ---- Worker (poller) ----
# Default poll interval (seconds) when a connector doesn't specify one.
DEFAULT_POLL_INTERVAL_SECONDS=300
# FinOps: flag a cost anomaly when month-to-date AWS spend exceeds the previous
# month's total by more than this percentage. One event per project per month.
COST_ANOMALY_THRESHOLD_PCT=20

# ---- AI insights (optional) ----
# Generates a short natural-language health summary per project on a schedule.
# Leave AI_API_KEY empty to disable the feature entirely.
# Provider: "anthropic" (default) or "openai" (any OpenAI-compatible endpoint).
AI_PROVIDER=anthropic
AI_API_KEY=
# Model id. Defaults: claude-3-5-haiku-latest (anthropic) / gpt-4o-mini (openai).
AI_MODEL=
# Override the API base URL (e.g. a self-hosted OpenAI-compatible server).
AI_BASE_URL=
# Generation cadence in ms (default 21600000 = 6h).
AI_INSIGHTS_INTERVAL_MS=

# ---- Email alerts (SMTP) ----
# Optional. Leave SMTP_HOST empty to disable email notifications.
SMTP_HOST=
SMTP_PORT=587
# "true" forces TLS on connect (implicit TLS, typically port 465).
# Otherwise STARTTLS is used when offered.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# From address for alert emails. Falls back to SMTP_USER when empty.
SMTP_FROM=
